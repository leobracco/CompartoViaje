# Servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# CouchDB
COUCHDB_URL=http://admin:admin@localhost:5984
COUCHDB_DB_PREFIX=compartoviaje

# JWT
JWT_SECRET=cambiar-en-produccion-usar-openssl-rand-hex-64
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Mercado Pago (obtener en https://www.mercadopago.com.ar/developers)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=cambiar-webhook-secret
MP_PLATFORM_FEE_PERCENT=10

# OAuth (opcional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Email transaccional (opcional, SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@compartoviaje.ar

# Notificaciones push (VAPID para Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@compartoviaje.ar

# Admin
ADMIN_EMAIL=admin@compartoviaje.ar
ADMIN_PASSWORD=cambiar-en-produccion
